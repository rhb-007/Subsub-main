{
  "name": "subsub-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "db:migrate": "wrangler d1 execute subsub-db --file=./worker/schema.sql",
    "db:migrate:local": "wrangler d1 execute subsub-db --local --file=./worker/schema.sql",
    "deploy": "wrangler deploy",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "hono": "^4.6.11",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.11",
    "wrangler": "^4.1.0"
  }
}
