{
  "name": "subsub-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "db:migrate": "wrangler d1 execute subsub-db --file=./worker/schema.sql",
    "db:migrate:local": "wrangler d1 execute subsub-db --local --file=./worker/schema.sql",
    "deploy": "wrangler deploy",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:hostnames": "node scripts/hostnames-test.mjs",
    "test:setup": "node scripts/setup-check-test.mjs",
    "test:owner": "node scripts/owner-scope-test.mjs",
    "test:tenants": "node scripts/tenants-test.mjs",
    "test:subdomain": "node scripts/subdomain-test.mjs",
    "test:migrations": "node --no-warnings scripts/migration-message-test.mjs",
    "test:invites": "node scripts/tenant-invite-test.mjs",
    "test:visits": "node scripts/tenant-visit-test.mjs",
    "test:reports": "node scripts/tenant-report-test.mjs",
    "test:decline": "node scripts/decline-test.mjs",
    "test:notify": "wrangler d1 execute subsub-db --config=./wrangler.toml --local --file=./scripts/tenant-notify-fixture.sql && node scripts/tenant-notify-test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "hono": "^4.6.11",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.11",
    "wrangler": "^4.1.0"
  }
}
