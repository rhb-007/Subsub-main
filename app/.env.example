# Real auth (Supabase). Copy this file to .env, fill in the anon key, and
# `npm run dev` will use real Supabase sign-in instead of the demo-account
# picker. Leave .env absent (or these two blank) to keep using the dev-stub
# auth — that's what app/scripts/e2e-*.mjs rely on, so don't set this file
# up in a way that breaks those unless you're updating the tests too.
#
# Both values are meant to be public — Vite bakes VITE_-prefixed vars into
# the client bundle, and that's expected here (the anon key isn't a secret;
# Supabase enforces access with Row Level Security / this API's own checks).
VITE_SUPABASE_URL=https://qxioxairvpbqaiottcxu.supabase.co
VITE_SUPABASE_ANON_KEY=
